G [label="G 材料定稿与答辩演练\n持续 1 天 | TF=0\nES=5 EF=6 | LS=5 LF=6", color="#ab423f", fillcolor="#fff0ed"];
H [label="H 课程提交与运行检查\n持续 1 天 | TF=0\nES=6 EF=7 | LS=6 LF=7", color="#ab423f", fillcolor="#fff0ed"];
A -> B;
