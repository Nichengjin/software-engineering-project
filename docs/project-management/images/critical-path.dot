digraph CPM { rankdir=LR; graph [bgcolor="white", fontname="PingFang SC", fontsize=20, pad="0.3", nodesep="0.4", ranksep="0.6"]; node [shape=box, style="rounded,filled", fillcolor="#f4f7fa", color="#536473", fontname="PingFang SC", fontsize=14, margin="0.18,0.13"]; edge [color="#536473", arrowsize=0.7];
label="剩余交付计划的工程网络图（天）\n红色：关键活动；ES/EF 为最早时间，LS/LF 为最迟时间"; labelloc=t;
