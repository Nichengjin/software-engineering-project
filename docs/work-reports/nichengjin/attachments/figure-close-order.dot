digraph G {
graph [rankdir=TB, newrank=true, bgcolor="white", pad=0.35, nodesep=0.5, ranksep=0.6, splines=polyline, fontname="PingFang SC", fontsize=23, fontcolor="#24364b", labelloc=t, label="关闭选课的准入与等待顺序\n "];
node [shape=box, style="rounded,filled", fillcolor="#eef4f9", color="#cad4df", penwidth=1.3, fontname="PingFang SC", fontsize=17, fontcolor="#24364b", margin="0.22,0.16"];
edge [color="#355f87", penwidth=1.5, arrowsize=0.7, fontname="PingFang SC", fontsize=14, fontcolor="#64748b"];

  close [label="发起关闭选课\n立即停止新的写请求准入"];
  reject [label="新发起的写请求\n拒绝进入，页面重新读取", fillcolor="#fff3ed"];
  active [label="已取得准入的请求\n继续事务并检查自然截止"];
  wait [label="等待已准入请求全部结束\n等待期间不持有普通写锁"];
  settle [label="进入关闭事务\n调剂、取消、形成完整账单"];
  persist [label="同一事务提交\n最终课表＋账单版本＋待发送记录"];
  closed [label="关闭完成\n计费暂时失败不撤销关闭", fillcolor="#eef7f3"];
  send [label="事务提交后后台发送账单\n未确认的账单按原编号重试"];
  close -> wait; close -> reject [label="新请求"];
  active -> wait [label="处理结束"];
  {rank=same; close; active;}
  {rank=same; reject; wait;}
  wait -> settle -> persist -> closed -> send;

}
