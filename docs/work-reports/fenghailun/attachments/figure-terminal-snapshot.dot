digraph G {
graph [rankdir=TB, newrank=true, bgcolor="white", pad=0.35, nodesep=0.5, ranksep=0.6, splines=polyline, fontname="PingFang SC", fontsize=23, fontcolor="#24364b", labelloc=t, label="负载结束后的终态取数顺序\n "];
node [shape=box, style="rounded,filled", fillcolor="#eef4f9", color="#cad4df", penwidth=1.3, fontname="PingFang SC", fontsize=17, fontcolor="#24364b", margin="0.22,0.16"];
edge [color="#355f87", penwidth=1.5, arrowsize=0.7, fontname="PingFang SC", fontsize=14, fontcolor="#64748b"];

  subgraph cluster_old {
    label="旧顺序\n终态尚未稳定";fontsize=17;color="#e8c5b9";style=rounded;
    oldend [label="客户端测量结束"];
    oldread [label="立即读取数据库快照\n后端可能仍在处理",fillcolor="#fff3ed"];
    oldcompare [label="比较课表与注册\n可能得到暂时差异",fillcolor="#fff3ed"];
    oldwait [label="到清理阶段才等待后端"];
    oldend -> oldread -> oldcompare -> oldwait;
  }
  subgraph cluster_new {
    label="修正后\n等待处理结束再核对";fontsize=17;color="#b8d4cb";style=rounded;
    end [label="客户端测量结束"];
    stop [label="停止后台轮询\n不再产生新的请求"];
    wait [label="等待已进入处理的业务结束"];
    read [label="读取稳定的数据库快照"];
    compare [label="核对课表、注册、容量\n及客户端最后确认结果",fillcolor="#eef7f3"];
    end -> stop -> wait -> read -> compare;
  }
  {rank=same;oldend;end;}
  {rank=same;oldread;stop;}
  {rank=same;oldcompare;wait;}
  {rank=same;oldwait;read;}

}
