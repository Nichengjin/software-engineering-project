digraph G {
graph [rankdir=TB, newrank=true, bgcolor="white", pad=0.35, nodesep=0.5, ranksep=0.6, splines=polyline, fontname="PingFang SC", fontsize=23, fontcolor="#24364b", labelloc=t, label="人员状态变更的预览与确认\n "];
node [shape=box, style="rounded,filled", fillcolor="#eef4f9", color="#cad4df", penwidth=1.3, fontname="PingFang SC", fontsize=17, fontcolor="#24364b", margin="0.22,0.16"];
edge [color="#355f87", penwidth=1.5, arrowsize=0.7, fontname="PingFang SC", fontsize=14, fontcolor="#64748b"];

  edit [label="选择人员与目标状态\n保留开始编辑时的版本"];
  preview [label="预览本次修改的影响\n当前课程／授课／账号与会话"];
  confirm [label="教务核对后确认\n提交同一份修改与预览凭据"];
  check [shape=diamond,style=filled,label="事务内重新校验：\n版本、关联数据与关闭状态一致？",fontsize=16];
  redo [label="拒绝使用旧预览\n重新读取、预览并确认",fillcolor="#fff3ed"];
  tx [label="同一事务内处理\n课程清理＋人员状态＋会话＋审计"];
  success [label="全部成功后提交\n显示最新人员状态",fillcolor="#eef7f3"];
  fail [label="任一步失败则整体回滚\n保留操作前的数据",fillcolor="#fff3ed"];
  edit -> preview -> confirm -> check;
  check -> redo [label="否"];check -> tx [label="是"];
  tx -> success [label="成功"];tx -> fail [label="失败"];
  {rank=same;redo;tx;}
  {rank=same;success;fail;}

}
