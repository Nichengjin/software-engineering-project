# Copy to .env (ignored). Never commit real credentials.
# scripts/postgres-prepare.sh writes random local credentials automatically in orbs.
POSTGRES_USER=wylie
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=wylie
DATABASE_URL=postgresql://wylie:replace-with-a-random-local-password@127.0.0.1:5432/wylie
TEST_DATABASE_URL=postgresql://wylie:replace-with-a-random-local-password@127.0.0.1:5432/wylie_test
API_PORT=3000
SIM_PORT=3001
WEB_ORIGIN=http://localhost:5173
PUBLIC_ORIGIN=http://localhost:5173
CATALOG_BASE_URL=http://127.0.0.1:3001
BILLING_BASE_URL=http://127.0.0.1:3001
EXTERNAL_SERVICE_TOKEN=replace-with-an-independent-random-token
IMPACT_SIGNING_KEY=replace-with-an-independent-random-key
CSRF_SIGNING_KEY=replace-with-an-independent-random-key
PRICE_PER_CREDIT_YUAN=100.00
SIM_STATE_PATH=tmp/simulators-state.json
SIM_SEED_PATH=packages/db/seed/catalog.json
SIM_CONTROL_ENABLED=false
SIM_CONTROL_TOKEN=replace-with-an-independent-random-token
