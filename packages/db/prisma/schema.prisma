generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PROFESSOR
  REGISTRAR
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
}

enum ProfessorStatus {
  ACTIVE
  DEPARTED
}

enum CloseState {
  OPEN
  CLOSING
  CLOSED
}

enum OfferingStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum RegistrationSource {
  SUBMIT
  LEVELING
  SUPPLEMENT
}

enum RegistrationState {
  ENROLLED
  COMMITTED
  REMOVED
}

enum Grade {
  A
  B
  C
  D
  F
  I
}

enum GradeSource {
  PROFESSOR
  IMPORT
}

enum NoticeKind {
  TIME_CONFLICT
  PREREQUISITE
  OFFERING_DELETED
}

enum BillingStatus {
  PENDING
  IN_FLIGHT
  RETRY
  ACKNOWLEDGED
  SUPERSEDED
}

model Account {
  id                 String        @id @default(uuid()) @db.Uuid
  account            String        @unique
  passwordHash       String
  role               Role
  enabled            Boolean       @default(true)
  mustChangePassword Boolean       @default(true)
  studentId          String?       @unique @db.Uuid
  professorId        String?       @unique @db.Uuid
  student            Student?      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  professor          Professor?    @relation(fields: [professorId], references: [id], onDelete: Restrict)
  sessions           Session[]
  updatedGrades      GradeRecord[]
  auditEvents        AuditEvent[]
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  csrfHash  String
  accountId String   @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([accountId])
  @@index([expiresAt])
}

model Student {
  id             String          @id @default(uuid()) @db.Uuid
  studentNumber  String          @unique @default(dbgenerated("('S'::text || lpad((nextval('student_number_seq'::regclass))::text, 6, '0'::text))"))
  name           String
  birthDate      DateTime        @db.Date
  ssn            String          @unique
  status         StudentStatus   @default(ACTIVE)
  graduationDate DateTime?       @db.Date
  version        Int             @default(1)
  account        Account?
  identity       PersonIdentity?
  schedules      Schedule[]
  registrations  Registration[]
  grades         GradeRecord[]
  notices        CatalogNotice[]
  bills          BillingOutbox[]
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
}

model Professor {
  id               String            @id @default(uuid()) @db.Uuid
  professorNumber  String            @unique @default(dbgenerated("('P'::text || lpad((nextval('professor_number_seq'::regclass))::text, 6, '0'::text))"))
  name             String
  birthDate        DateTime          @db.Date
  ssn              String            @unique
  status           ProfessorStatus   @default(ACTIVE)
  department       String
  version          Int               @default(1)
  account          Account?
  identity         PersonIdentity?
  offerings        Offering[]
  teachingVersions TeachingVersion[]
  teachingHistory  TeachingHistory[]
  qualifications   Qualification[]
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
}

model PersonIdentity {
  ssn         String     @id
  studentId   String?    @unique @db.Uuid
  professorId String?    @unique @db.Uuid
  student     Student?   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  professor   Professor? @relation(fields: [professorId], references: [id], onDelete: Restrict)
}

model Term {
  id                    String            @id @default(uuid()) @db.Uuid
  name                  String
  ordinal               Int               @unique
  startsAt              DateTime          @db.Timestamptz(3)
  endsAt                DateTime          @db.Timestamptz(3)
  isLaunchTerm          Boolean           @default(false)
  teachingStartsAt      DateTime          @db.Timestamptz(3)
  initialStartsAt       DateTime          @db.Timestamptz(3)
  initialEndsAt         DateTime          @db.Timestamptz(3)
  addDropStartsAt       DateTime          @db.Timestamptz(3)
  addDropEndsAt         DateTime          @db.Timestamptz(3)
  closeState            CloseState        @default(OPEN)
  version               Int               @default(1)
  closedAt              DateTime?         @db.Timestamptz(3)
  closeAttemptId        String?           @db.Uuid
  lastCloseError        Json?
  closeResult           Json?
  closedCatalogSnapshot Json?
  pricePerCreditYuan    Decimal?          @db.Decimal(12, 2)
  catalogSnapshot       CatalogSnapshot?
  offerings             Offering[]
  schedules             Schedule[]
  teachingVersions      TeachingVersion[]
  grades                GradeRecord[]
  notices               CatalogNotice[]
  bills                 BillingOutbox[]
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
}

model CatalogSnapshot {
  termId     String   @id @db.Uuid
  term       Term     @relation(fields: [termId], references: [id], onDelete: Restrict)
  revision   String
  payload    Json
  observedAt DateTime @db.Timestamptz(3)
}

model CourseMirror {
  externalCourseId String  @id
  name             String
  department       String
  credits          Decimal @db.Decimal(5, 2)
  prerequisiteIds  Json
  revision         String
}

model Offering {
  externalOfferingId String            @id
  termId             String            @db.Uuid
  term               Term              @relation(fields: [termId], references: [id], onDelete: Restrict)
  courseId           String
  status             OfferingStatus    @default(OPEN)
  cancelReason       String?
  professorId        String?           @db.Uuid
  professor          Professor?        @relation(fields: [professorId], references: [id], onDelete: Restrict)
  catalogDeleted     Boolean           @default(false)
  registrations      Registration[]
  teachingHistory    TeachingHistory[]
  grades             GradeRecord[]
  notices            CatalogNotice[]   @relation("NoticeOffering")
  relatedNotices     CatalogNotice[]   @relation("RelatedOffering")
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  @@index([termId, status])
  @@index([professorId])
}

model TeachingVersion {
  professorId String    @db.Uuid
  termId      String    @db.Uuid
  version     Int       @default(0)
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Restrict)
  term        Term      @relation(fields: [termId], references: [id], onDelete: Restrict)

  @@id([professorId, termId])
}

model Schedule {
  id               String    @id @default(uuid()) @db.Uuid
  studentId        String    @db.Uuid
  termId           String    @db.Uuid
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term             Term      @relation(fields: [termId], references: [id], onDelete: Restrict)
  version          Int       @default(0)
  exists           Boolean   @default(false)
  firstSubmittedAt DateTime? @db.Timestamptz(3)
  savedChoices     Json      @default("{\"primaryOfferingIds\":[],\"alternateOfferingIds\":[]}")
  submittedChoices Json?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([studentId, termId])
}

model Registration {
  id            String             @id @default(uuid()) @db.Uuid
  studentId     String             @db.Uuid
  offeringId    String
  student       Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  offering      Offering           @relation(fields: [offeringId], references: [externalOfferingId], onDelete: Restrict)
  source        RegistrationSource
  state         RegistrationState  @default(ENROLLED)
  removedReason String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  @@index([offeringId, state])
  @@index([studentId, state])
}

model TeachingHistory {
  id          String    @id @default(uuid()) @db.Uuid
  professorId String    @db.Uuid
  offeringId  String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Restrict)
  offering    Offering  @relation(fields: [offeringId], references: [externalOfferingId], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  endedAt     DateTime? @db.Timestamptz(3)

  @@index([professorId])
  @@index([offeringId])
}

model Qualification {
  professorId String    @db.Uuid
  courseId    String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Restrict)

  @@id([professorId, courseId])
}

model GradeRecord {
  id                 String      @id @default(uuid()) @db.Uuid
  studentId          String      @db.Uuid
  termId             String      @db.Uuid
  courseId           String
  offeringId         String?
  student            Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term               Term        @relation(fields: [termId], references: [id], onDelete: Restrict)
  offering           Offering?   @relation(fields: [offeringId], references: [externalOfferingId], onDelete: Restrict)
  value              Grade?
  source             GradeSource
  courseNameSnapshot String
  updatedByAccountId String?     @db.Uuid
  updatedBy          Account?    @relation(fields: [updatedByAccountId], references: [id], onDelete: Restrict)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([studentId, courseId, termId])
  @@index([offeringId])
}

model CatalogNotice {
  id                String     @id @default(uuid()) @db.Uuid
  studentId         String     @db.Uuid
  termId            String     @db.Uuid
  offeringId        String
  relatedOfferingId String?
  student           Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term              Term       @relation(fields: [termId], references: [id], onDelete: Restrict)
  offering          Offering   @relation("NoticeOffering", fields: [offeringId], references: [externalOfferingId], onDelete: Restrict)
  relatedOffering   Offering?  @relation("RelatedOffering", fields: [relatedOfferingId], references: [externalOfferingId], onDelete: Restrict)
  kind              NoticeKind
  message           String
  resolved          Boolean    @default(false)
  revision          String
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)

  @@index([studentId, termId, resolved])
}

model BillingOutbox {
  id             String        @id @default(uuid()) @db.Uuid
  studentId      String        @db.Uuid
  termId         String        @db.Uuid
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term           Term          @relation(fields: [termId], references: [id], onDelete: Restrict)
  version        Int
  businessId     String        @unique
  payload        Json
  amountYuan     Decimal       @db.Decimal(12, 2)
  status         BillingStatus @default(PENDING)
  attempts       Int           @default(0)
  nextAttemptAt  DateTime      @default(now()) @db.Timestamptz(3)
  leaseUntil     DateTime?     @db.Timestamptz(3)
  lastErrorCode  String?
  acknowledgedAt DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([studentId, termId, version])
  @@index([status, nextAttemptAt])
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  requestId      String
  actorAccountId String?  @db.Uuid
  actor          Account? @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)
  processName    String?
  action         String
  objectType     String
  objectId       String
  at             DateTime @default(now()) @db.Timestamptz(3)
  result         String
  errorCode      String?
  minimalDetails Json

  @@index([requestId])
  @@index([at])
}
