{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts", "scripts/*.mjs", "tests/**/*.ts", "tests/**/*.tsx", "vitest.config.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
